{
  "name": "@ezcorp/extension-contract",
  "version": "4.0.0",
  "type": "module",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "bun": "./src/index.ts", "import": "./dist/index.js" },
    "./legacy": { "types": "./dist/legacy.d.ts", "bun": "./src/legacy.ts", "import": "./dist/legacy.js" },
    "./entities": { "types": "./dist/entities.d.ts", "bun": "./src/entities.ts", "import": "./dist/entities.js" }
  },
  "scripts": { "build": "tsc -b tsconfig.build.json", "test": "bun test", "schema:generate": "ts-json-schema-generator --path src/types.ts --type WireData --tsconfig tsconfig.build.json --no-type-check --out src/wire-schema.json", "schema:check": "bun test ./src/schema.test.ts" },
  "dependencies": { "ajv": "8.17.1", "re2js": "2.8.6" },
  "devDependencies": { "typescript": "^5.9.3", "ts-json-schema-generator": "2.4.0" }
}
