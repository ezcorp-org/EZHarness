{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "skipLibCheck": true, "composite": true, "declaration": true, "outDir": "dist", "rootDir": "src",
    "resolveJsonModule": true, "esModuleInterop": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"], "exclude": ["src/**/*.test.ts"]
}
