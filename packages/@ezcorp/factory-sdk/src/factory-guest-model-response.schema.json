{
  "$id": "urn:ezcorp:factory:guest-model-response:v1",
  "$ref": "#/definitions/FactoryGuestModelResponse",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FactoryCheckpointReference": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "encodedBytes": {
          "type": "number"
        },
        "journalCursor": {
          "type": "number"
        }
      },
      "required": [
        "artifactId",
        "digest",
        "encodedBytes",
        "journalCursor"
      ],
      "type": "object"
    },
    "FactoryGuestModelRefusal": {
      "description": "Why a model call was refused. A refusal is never a quiet substitution.\n\nThree codes name a provider that answered with an error: `provider_auth_failed` (it refused the credential), `provider_rate_limited` (it refused for rate), and `provider_unavailable` (anything else, including every error the host cannot classify; a narrower code is never guessed).",
      "enum": [
        "model_pin_mismatch",
        "input_too_large",
        "operation_busy",
        "operation_settled",
        "provider_unavailable",
        "provider_auth_failed",
        "provider_rate_limited",
        "invalid_request"
      ],
      "type": "string"
    },
    "FactoryGuestModelResponse": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string"
            },
            "providerReceiptDigest": {
              "type": "string"
            },
            "schemaVersion": {
              "const": "factory.guest-model-response.v1",
              "type": "string"
            },
            "status": {
              "const": "completed",
              "type": "string"
            },
            "text": {
              "description": "The whole answer. There is no second hop, so a partial answer is a failure.",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryMeasuredUsage"
            }
          },
          "required": [
            "schemaVersion",
            "status",
            "operationId",
            "text",
            "providerReceiptDigest",
            "usage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "$ref": "#/definitions/FactoryRunnerFailedOperation",
              "description": "The operation exactly as the host journaled it, present when the call was claimed and settled `failed`. A guest copies it into its result's `operations` unchanged: the host verifies a result against its journal byte for byte, and only the host knows the settled code and usage."
            },
            "operationId": {
              "type": "string"
            },
            "refusal": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "$ref": "#/definitions/FactoryGuestModelRefusal"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "schemaVersion": {
              "const": "factory.guest-model-response.v1",
              "type": "string"
            },
            "status": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "status",
            "operationId",
            "refusal"
          ],
          "type": "object"
        }
      ]
    },
    "FactoryMeasuredUsage": {
      "additionalProperties": false,
      "properties": {
        "computeMs": {
          "type": "number"
        },
        "costMicros": {
          "type": "string"
        },
        "inputTokens": {
          "type": "number"
        },
        "kind": {
          "const": "measured",
          "type": "string"
        },
        "outputTokens": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "inputTokens",
        "outputTokens",
        "computeMs",
        "costMicros"
      ],
      "type": "object"
    },
    "FactoryRunnerFailedOperation": {
      "additionalProperties": false,
      "description": "A settled `failed` operation, the one shape a refused model call may hand back.",
      "properties": {
        "kind": {
          "enum": [
            "model",
            "tool"
          ],
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "operationIndex": {
          "type": "number"
        },
        "providerReceiptDigest": {
          "type": "string"
        },
        "requestDigest": {
          "type": "string"
        },
        "resultDigest": {
          "type": "string"
        },
        "state": {
          "const": "failed",
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/FactoryUsage"
        },
        "workspaceCheckpoint": {
          "$ref": "#/definitions/FactoryCheckpointReference"
        }
      },
      "required": [
        "kind",
        "operationId",
        "operationIndex",
        "requestDigest",
        "resultDigest",
        "state"
      ],
      "type": "object"
    },
    "FactoryUnknownUsage": {
      "additionalProperties": false,
      "properties": {
        "heldCostMicros": {
          "type": "string"
        },
        "kind": {
          "const": "unknown",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "heldCostMicros"
      ],
      "type": "object"
    },
    "FactoryUsage": {
      "anyOf": [
        {
          "$ref": "#/definitions/FactoryMeasuredUsage"
        },
        {
          "$ref": "#/definitions/FactoryUnknownUsage"
        }
      ]
    }
  }
}