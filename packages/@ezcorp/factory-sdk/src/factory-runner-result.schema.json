              "enum": [
                "model",
                "tool"
              ],
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "operationIndex": {
              "type": "number"
            },
            "providerReceiptDigest": {
              "type": "string"
            },
            "requestDigest": {
              "type": "string"
            },
            "resultDigest": {
              "type": "string"
            },
            "state": {
              "const": "failed",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryUsage"
            },
            "workspaceCheckpoint": {
              "$ref": "#/definitions/FactoryCheckpointReference"
            }
          },
          "required": [
            "kind",
            "operationId",
            "operationIndex",
            "requestDigest",
            "resultDigest",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
