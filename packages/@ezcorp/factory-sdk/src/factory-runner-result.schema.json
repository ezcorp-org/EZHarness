        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "model",
                "tool"
              ],
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "operationIndex": {
              "type": "number"
            },
            "providerReceiptDigest": {
              "type": "string"
            },
            "requestDigest": {
              "type": "string"
            },
            "resultDigest": {
              "type": "string"
            },
            "state": {
              "const": "completed",
              "type": "string"
