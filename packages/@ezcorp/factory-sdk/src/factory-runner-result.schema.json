              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "operationIndex": {
              "type": "number"
            },
            "providerReceiptDigest": {
              "type": "string"
            },
            "requestDigest": {
              "type": "string"
            },
            "resultDigest": {
              "type": "string"
            },
            "state": {
              "const": "uncertain",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryUnknownUsage"
            },
            "workspaceCheckpoint": {
              "$ref": "#/definitions/FactoryCheckpointReference"
            }
          },
          "required": [
            "kind",
            "operationId",
            "operationIndex",
            "providerReceiptDigest",
            "requestDigest",
            "state",
            "usage"
          ],
          "type": "object"
        }
      ]
