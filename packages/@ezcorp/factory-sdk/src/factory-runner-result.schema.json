              "type": "array"
            },
            "resultDigest": {
              "type": "string"
            },
            "schemaVersion": {
              "const": "factory.runner.result.v1",
              "type": "string"
            },
            "status": {
              "const": "failed",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryUsage"
            },
            "workspaceCheckpoint": {
              "$ref": "#/definitions/FactoryCheckpointReference"
            }
          },
          "required": [
            "error",
            "journalCursor",
            "operations",
            "resultDigest",
            "schemaVersion",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
