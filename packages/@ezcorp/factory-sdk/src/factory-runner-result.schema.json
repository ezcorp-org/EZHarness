{
  "$ref": "#/definitions/FactoryRunnerResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FactoryArtifactReference": {
      "additionalProperties": false,
      "description": "Opaque, immutable object reference. Ownership is resolved by the gateway.",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "encodedBytes": {
          "type": "number"
        }
      },
      "required": [
        "artifactId",
        "digest",
        "encodedBytes"
      ],
      "type": "object"
    },
    "FactoryCheckpointReference": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "encodedBytes": {
          "type": "number"
        },
        "journalCursor": {
          "type": "number"
        }
      },
      "required": [
        "artifactId",
        "digest",
        "encodedBytes",
        "journalCursor"
      ],
      "type": "object"
    },
    "FactoryMeasuredUsage": {
      "additionalProperties": false,
      "properties": {
        "computeMs": {
          "type": "number"
        },
        "costMicros": {
          "type": "string"
        },
        "inputTokens": {
          "type": "number"
        },
        "kind": {
          "const": "measured",
          "type": "string"
        },
        "outputTokens": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "inputTokens",
        "outputTokens",
        "computeMs",
        "costMicros"
      ],
      "type": "object"
    },
