    "FactoryUnknownUsage": {
      "additionalProperties": false,
      "properties": {
        "heldCostMicros": {
          "type": "string"
        },
        "kind": {
          "const": "unknown",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "heldCostMicros"
      ],
      "type": "object"
    },
    "FactoryUsage": {
      "anyOf": [
        {
          "$ref": "#/definitions/FactoryMeasuredUsage"
        },
        {
          "$ref": "#/definitions/FactoryUnknownUsage"
        }
