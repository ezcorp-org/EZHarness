                "$ref": "#/definitions/FactoryRunnerOperationResult"
              },
              "type": "array"
            },
            "schemaVersion": {
              "const": "factory.runner.result.v1",
              "type": "string"
            },
            "status": {
              "const": "cancelled",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryUsage"
            },
            "workspaceCheckpoint": {
              "$ref": "#/definitions/FactoryCheckpointReference"
            }
          },
          "required": [
            "journalCursor",
            "operations",
            "schemaVersion",
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "journalCursor": {
              "type": "number"
            },
            "operations": {
              "items": {
                "$ref": "#/definitions/FactoryRunnerOperationResult"
              },
              "type": "array"
            },
            "providerReceiptDigest": {
              "type": "string"
            },
            "resultDigest": {
              "type": "string"
            },
            "schemaVersion": {
              "const": "factory.runner.result.v1",
              "type": "string"
            },
            "status": {
              "const": "uncertain",
              "type": "string"
            },
            "usage": {
              "$ref": "#/definitions/FactoryUnknownUsage"
            },
            "workspaceCheckpoint": {
              "$ref": "#/definitions/FactoryCheckpointReference"
            }
