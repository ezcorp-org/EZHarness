{
  "$id": "urn:ezcorp:factory:validator-report:v1",
  "$ref": "#/definitions/FactoryValidatorReport",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FactoryArtifactReference": {
      "additionalProperties": false,
      "description": "Opaque, immutable object reference. Ownership is resolved by the gateway.",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "encodedBytes": {
          "type": "number"
        }
      },
      "required": [
        "artifactId",
        "digest",
        "encodedBytes"
      ],
      "type": "object"
    },
    "FactoryModelPin": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "object"
        },
        "configurationDigest": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "policy": {
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "object"
        },
        "policyDigest": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "configurationDigest",
        "configuration",
        "policyDigest",
        "policy"
      ],
      "type": "object"
    },
    "FactoryValidatorClaimOutcome": {
      "additionalProperties": false,
      "properties": {
        "decisive": {
          "description": "A decisive claim can close its group alone.",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/definitions/FactoryArtifactReference"
          },
          "maxItems": 100,
          "type": "array"
        },
        "id": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "measuredAtMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "number"
        },
        "reasonCode": {
          "description": "Machine-readable reason.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "maxLength": 2048,
          "type": "string"
        },
        "verdict": {
          "$ref": "#/definitions/FactoryValidatorVerdict"
        }
      },
      "required": [
        "id",
        "verdict",
        "decisive",
        "summary",
        "reasonCode",
        "evidence",
        "measuredAtMs"
      ],
      "type": "object"
    },
    "FactoryValidatorError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "FactoryValidatorProvenance": {
      "additionalProperties": false,
      "description": "Gateway-sealed provenance. Every field is read from the durable assignment row.",
      "properties": {
        "attemptId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "candidateDigest": {
          "maxLength": 71,
          "minLength": 71,
          "type": "string"
        },
        "candidateGeneration": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "number"
        },
        "candidateNodeInstanceId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "configurationDigest": {
          "maxLength": 71,
          "minLength": 71,
          "type": "string"
        },
        "environmentDigest": {
          "maxLength": 71,
          "minLength": 71,
          "type": "string"
        },
        "expiresAtMs": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "number"
        },
        "issuedAtMs": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "number"
        },
        "issuerGrantRevision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "number"
        },
        "model": {
          "$ref": "#/definitions/FactoryModelPin"
        },
        "projectId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "runId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "runnerDigest": {
          "maxLength": 71,
          "minLength": 71,
          "type": "string"
        },
        "tenantId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "trustRevision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "number"
        },
        "validatorLockDigest": {
          "maxLength": 71,
          "minLength": 71,
          "type": "string"
        }
      },
      "required": [
        "attemptId",
        "tenantId",
        "projectId",
        "runId",
        "candidateNodeInstanceId",
        "candidateGeneration",
        "candidateDigest",
        "validatorLockDigest",
        "runnerDigest",
        "environmentDigest",
        "configurationDigest",
        "trustRevision",
        "issuerGrantRevision",
        "issuedAtMs",
        "expiresAtMs"
      ],
      "type": "object"
    },
    "FactoryValidatorReport": {
      "additionalProperties": false,
      "description": "The sealed report. Only the gateway validator path constructs one.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/definitions/FactoryValidatorClaimOutcome"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "error": {
          "$ref": "#/definitions/FactoryValidatorError"
        },
        "provenance": {
          "$ref": "#/definitions/FactoryValidatorProvenance"
        },
        "schemaVersion": {
          "const": "factory.validator-report.v1",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "provenance",
        "claims"
      ],
      "type": "object"
    },
    "FactoryValidatorVerdict": {
      "description": "A process exit alone is never a verdict. Only this union decides a protected claim.",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "VALIDATOR_ERROR"
      ],
      "type": "string"
    },
    "JsonPrimitive": {
      "type": [
        "null",
        "boolean",
        "number",
        "string"
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonPrimitive"
        },
        {
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "object"
        }
      ]
    }
  }
}