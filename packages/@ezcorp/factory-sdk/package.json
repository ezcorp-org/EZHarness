{
  "name": "@ezcorp/factory-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Authoring, validation, compilation, and deterministic execution contracts for EZCorp factories.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "bun": "./src/validation.ts",
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./schema": {
      "bun": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./expressions": {
      "bun": "./src/expressions.ts",
      "types": "./dist/expressions.d.ts",
      "import": "./dist/expressions.js"
    },
    "./kernel": {
      "bun": "./src/kernel.ts",
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./kernel-types": {
      "bun": "./src/kernel-types.ts",
      "types": "./dist/kernel-types.d.ts",
      "import": "./dist/kernel-types.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -b tsconfig.build.json",
    "test": "bun test ./src",
    "schema:generate": "bunx --bun ts-json-schema-generator --path src/types.ts --type FactoryDefinition --tsconfig tsconfig.build.json --no-type-check --out src/factory-definition.schema.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "ts-json-schema-generator": "2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "2.8.2"
  }
}
