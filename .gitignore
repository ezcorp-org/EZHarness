# dependencies
node_modules

# output
out
dist
*.tgz
tasks

# code coverage
coverage
*.lcov

# logs
logs
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# dotenv — never commit any .env* file, with one exception: *.example
# templates are explicitly tracked so contributors know what shape a
# concrete .env should take (real secrets must NEVER live in those).
.env
.env.*
!.env.*.example

# caches
.eslintcache
.cache
*.tsbuildinfo
*.d.ts.map
.fallow/
# `svelte-check --tsgo` opts into TypeScript's incremental build cache. It
# writes that cache into `.svelte-kit`, and FALLS BACK to `.svelte-check`
# when `.svelte-kit` has not been generated yet — i.e. in a fresh worktree
# before `svelte-kit sync`. 785 generated files land here, and because
# biome.json sets `vcs.useIgnoreFile: true`, ignoring the path is also what
# keeps `bun run lint` from linting them. See web/CLAUDE.md.
.svelte-check/

# editors
.idea
.vscode

# OS
.DS_Store

# agent runtime data
agent/sessions/
agent/auth.json
agent/settings.json

# Extension runtime data — every extension stores its persistent state under
# .ezcorp/extension-data/<ext-name>/ (see docs/extensions/README.md).
.ezcorp/

# Internal planning docs — milestone plans, phase research, roadmap drafts.
# Kept locally but not part of the public repo.
.planning/

# database
*.db
ez-corp-db/

# Runtime data dir (root + web/ when dev cwd=web). Holds installFromGitHub
# / installFromGit extension scratch copies and any local EZCORP_DB_PATH
# override pointed inside the tree. Root-anchored so it never shadows the
# tracked example data under docs/.../data/ or web/src/lib/data/.
/data/
/web/data/
**/data/extensions/

# wrangler
.wrangler

# pi-ai encryption key + salt (per-install secrets, never commit)
**/.pi-secret
**/.pi-salt

# playwright mcp
.playwright-mcp/

# playwright output (run artifacts, last-run cache, traces)
test-results/

# test project workspace
TESTENV/
web/e2e/.docker-auth.json
web/e2e/.real-auth.json
web/e2e/.validate-auth.json

# User-created projects. The live location is `.ezcorp/projects` (already
# covered by the `.ezcorp/` rule above) — every stack binds it there since
# PR #153. `/projects/` is kept because existing checkouts still have the
# old dir on disk and it must not become committable when they empty it.
/projects/

# Local git worktrees — checked-out branches under ./worktrees/ for parallel
# work. Never commit; the actual branches live in the remote.
worktrees/

# Local Claude Code agent config (per-machine, do not commit) — EXCEPT the two
# shared, committed maintenance tools for docs/features (everything else in
# .claude/ stays local).
#
# `.claude.json` is the per-machine MCP-server config that sits at the repo
# ROOT, so `.claude/*` below does NOT cover it — it was previously unignored
# and got swept into a `git add -A`. It holds local server commands and API
# keys; never commit it.
.claude.json
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/feature-doc.md
!.claude/workflows/
.claude/workflows/*
!.claude/workflows/feature-docs-review.js
coverage-shard/

web/playwright.local.config.ts

# Local-only deploy overrides (per-machine; this repo is PUBLIC).
#
# Same idiom as the .env rules above: the `.example` template is tracked so
# contributors know the shape, the concrete file never is.
#
# `deploy/preview-dns/Corefile` is the local copy of Corefile.example. The
# template is now env-driven (EZCORP_PREVIEW_ZONE / EZCORP_PREVIEW_TARGET_IP),
# so the copy no longer needs hand-edited host values — but it stays ignored so
# a local tweak can't leak a private address into this public repo.
deploy/preview-dns/Corefile

# NOTE: `compose.prod.projects.yml` used to be ignored here as a local-only
# override. It is now `compose.prod.localtest.yml` and is TRACKED: every
# host-specific value became an env knob with a safe default
# (EZCORP_TEST_BIND_IP defaults to loopback), so it is shareable.
# See docs/local-prod-test-stack.md.

# Scratch a merge tool drops when resolving conflicts (patches, a binary
# index backup, MERGE_HEAD copies). 1.1MB of it was committed by accident
# once already — see the ez-factory integration merge.
.merge-snapshot/
