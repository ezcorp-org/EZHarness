{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bash scripts/test.sh",
		"test:file": "bun test",
		"test:e2e": "bunx playwright test",
		"test:e2e:ui": "bunx playwright test --ui",
		"test:e2e:real": "PI_E2E_REAL=1 bunx playwright test --config playwright.real.config.ts",
		"test:e2e:real:ui": "PI_E2E_REAL=1 bunx playwright test --config playwright.real.config.ts --ui",
		"test:component": "bunx vitest run",
		"test:component:watch": "bunx vitest"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/jsdom": "^28.0.1",
		"@vitest/coverage-v8": "4.1.10",
		"jsdom": "^29.1.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@abhivarde/svelte-drawer": "^1.0.0",
		"@electric-sql/pglite": "^0.5.4",
		"ansi_up": "^6.0.6",
		"diff2html": "^3.4.56",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^3.20.0",
		"kokoro-js": "^1.2.0",
		"linkedom": "^0.18.13",
		"lucide-svelte": "^0.577.0",
		"marked": "^17.0.4",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-dnd-action": "^0.9.75",
		"zod": "^4.4.3"
	}
}
