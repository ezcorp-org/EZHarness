{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"test": "bash scripts/test.sh",
		"test:file": "bun test",
		"test:e2e": "bunx playwright test",
		"test:e2e:ui": "bunx playwright test --ui",
		"test:e2e:real": "PI_E2E_REAL=1 bunx playwright test --config playwright.real.config.ts",
		"test:e2e:real:ui": "PI_E2E_REAL=1 bunx playwright test --config playwright.real.config.ts --ui",
		"test:component": "bunx vitest run",
		"test:component:watch": "bunx vitest"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.3.1",
		"@types/jsdom": "^30.0.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "4.1.11",
		"jsdom": "^30.0.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.2.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.4",
		"ansi_up": "^6.0.6",
		"diff2html": "^3.4.56",
		"highlight.js": "^11.12.0",
		"isomorphic-dompurify": "^3.7.1",
		"kokoro-js": "^1.2.0",
		"linkedom": "^0.18.12",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.10",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-dnd-action": "^0.9.69",
		"zod": "^4.3.6"
	}
}
