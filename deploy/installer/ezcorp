#!/usr/bin/env bash
# EZCorp installer core. Every OS package is a thin wrapper around this.
#
#   ezcorp install            first run: config, pull, up, wait, open
#   ezcorp start | stop       lifecycle (stop leaves the podman machine up)
#   ezcorp status             engine, machine, containers, port, readiness, tier
#   ezcorp open               open the app in the default browser
#   ezcorp update [VERSION]   back up, pull, recreate, verify, roll back on fail
#   ezcorp runner-mode MODE    change extension isolation without changing data
#   ezcorp suggestions on|off local suggestion model (opt-in, ~1GB + 4g RAM)
#   ezcorp uninstall [--purge]
#
# DESIGN NOTE — why a script and not a native launcher.
# The product is already a browser app talking to a local server. A native
# shell would buy a menu-bar item and a double-clickable icon, and cost a
# second toolchain, a second signing pipeline and a second update path. The
# OS packages supply the icon; this supplies the behavior. The tray comes
# later, on top of this, unchanged.
#
# Everything the user sees is printed by say()/die(). No raw compose or podman
# output reaches them unless EZCORP_VERBOSE=1 — the audience for this script
# cannot act on a compose stack trace, and showing one is how a one-click
# install becomes a support ticket.
set -euo pipefail

VERSION_FALLBACK="1.3.0"
IMAGE_REPO="${EZCORP_IMAGE_REPO:-ghcr.io/ezcorp-org/ezcorp}"
UPDATE_REPO="${EZCORP_UPDATE_REPO:-ezcorp-org/ezharness}"
PORT_FIRST=4000
PORT_LAST=4020
READY_TIMEOUT_SECONDS="${EZCORP_READY_TIMEOUT:-300}"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Where things live ──────────────────────────────────────────────────────
#
# Config and data are split per-OS convention, EXCEPT on macOS where both sit
# under Application Support: that directory is inside the podman machine's
# default $HOME mount, so a bind mount from it needs no extra `podman machine
# init -v`. Putting data in ~/Library/Caches or /usr/local/var would silently
# fall outside the VM's view and fail at first boot.
case "$(uname -s)" in
  Darwin)
    CONFIG_DIR="${EZCORP_CONFIG_DIR:-$HOME/Library/Application Support/EZCorp}"
    DATA_ROOT="${EZCORP_DATA_ROOT:-$HOME/Library/Application Support/EZCorp/data-root}"
    ;;
  *)
    CONFIG_DIR="${EZCORP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/ezcorp}"
    DATA_ROOT="${EZCORP_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/ezcorp}"
    ;;
esac

ENV_FILE="$CONFIG_DIR/.env"
STATE_FILE="$CONFIG_DIR/config.json"
COMPOSE_INSTALLER="$HERE/compose.installer.yml"
COMPOSE_MACHINE="$HERE/compose.machine.yml"
COMPOSE_ISOLATED="$HERE/compose.isolated.yml"
COMPOSE_TRUSTED_LOCAL="$HERE/compose.trusted-local.yml"
# The app's own acknowledgement sentence (src/extensions/runner-mode.ts). It is
# written to .env only after terminal confirmation — see
# consent_trusted_local — never from a flag, an environment variable or a
# default.
UNSANDBOXED_ACK="I-understand-extensions-run-with-the-apps-full-powers"
RUNNER_MODE=""
# Packaged layout puts the config beside the script; the repo keeps it one
# level up in deploy/. Support both rather than duplicating the file.
if [ -d "$HERE/searxng" ]; then
  SEARXNG_CONFIG="${EZCORP_SEARXNG_CONFIG:-$HERE/searxng}"
else
  SEARXNG_CONFIG="${EZCORP_SEARXNG_CONFIG:-$HERE/../searxng}"
fi

say()  { printf '%s\n' "$*"; }
step() { printf '→ %s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
quiet() { if [ "${EZCORP_VERBOSE:-0}" = "1" ]; then "$@"; else "$@" >/dev/null 2>&1; fi; }

with_lifecycle_lock() {
  [ "$(uname -s)" = Linux ] || die "this installer core currently supports Linux only."
  command -v flock >/dev/null 2>&1 || die "flock is required to protect installer operations. Install util-linux and try again."
  command -v getent >/dev/null 2>&1 || die "getent is required to resolve a stable account home for the installer lock."
  command -v realpath >/dev/null 2>&1 || die "realpath is required to verify the installer lock location."
  local account_record account_name account_password account_uid account_gid account_gecos account_home account_shell
  account_record="$(getent passwd "$UID")" || die "could not resolve the account home for the installer lock."
  case "$account_record" in
    ""|*$'\n'*) die "could not resolve one account home for the installer lock." ;;
  esac
  IFS=: read -r account_name account_password account_uid account_gid account_gecos account_home account_shell <<< "$account_record"
  [ "$account_uid" = "$UID" ] && [[ "$account_home" = /* ]] && [ -d "$account_home" ] \
    || die "could not resolve a valid account home for the installer lock."
  # Login shells, cron and services may have different HOME/runtime/temp env.
  # The account database gives all commands for this UID the same lock root.
  local lock_dir="$account_home/.ezcorp-installer-lock" lock_file canonical_lock root result=0
  lock_file="$lock_dir/lifecycle.lock"
  canonical_lock="$(realpath -m -- "$lock_file")" || die "could not resolve the installer lock location."
  for root in "$CONFIG_DIR" "$DATA_ROOT"; do
    root="$(realpath -m -- "$root")" || die "could not resolve the installer data location."
    case "$canonical_lock" in
      "$root"|"${root%/}/"*) die "the lifecycle lock must stay outside config and data directories. Choose paths that do not contain $lock_dir." ;;
    esac
  done
  [ -d "$lock_dir" ] || mkdir -m 700 "$lock_dir" || die "could not create a private installer lock directory."
  [ ! -L "$lock_dir" ] && [ "$(stat -c '%u:%a' "$lock_dir")" = "$UID:700" ] \
    || die "the installer lock directory must be private and owned by your account: $lock_dir"
  umask 077
  # flock owns the descriptor and waits for this entire command. --close keeps
  # browser/engine descendants from retaining it after the installer exits.
  # Keep the inode across purge; deleting a live lock permits two owners.
  flock --nonblock --conflict-exit-code 75 --close "$lock_file" \
    bash -c 'source "$1"; shift; dispatch "$@"' ezcorp "$HERE/ezcorp" "$@" || result=$?
  [ "$result" != 75 ] || die "another EZCorp lifecycle command is running. Wait for it to finish, then try again."
  exit "$result"
}

# ── Engine ─────────────────────────────────────────────────────────────────
ENGINE="${EZCORP_CONTAINER_ENGINE:-}"
detect_engine() {
  [ -n "$ENGINE" ] && return 0
  if command -v podman >/dev/null 2>&1; then ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then ENGINE=docker
  else
    die "no container engine found.
  EZCorp runs on Podman. The installer normally installs it for you;
  if you are running this script directly, install Podman first:
    macOS:  https://podman.io/docs/installation
    Linux:  your distro's 'podman' package"
  fi
}

# Rootless podman is the case that needs the keep-id overlay. A podman running
# as root maps container uid 1000 to host uid 1000 already, and keep-id would
# be both unnecessary and wrong there.
engine_is_rootless_podman() {
  [ "$ENGINE" = "podman" ] || return 1
  [ "$(id -u)" != "0" ]
}

compose_cmd() {
  # The real Compose CLI over the podman socket is preferred for the same
  # reason scripts/podman-compose.sh gives. But that preference exists because
  # of `depends_on: condition: service_healthy`, which in THIS compose file is
  # confined to the opt-in suggest profile — so when it is off, podman's own
  # compose is perfectly adequate and one less thing to require.
  if command -v docker-compose >/dev/null 2>&1; then echo "docker-compose"
  elif docker compose version >/dev/null 2>&1; then echo "docker compose"
  elif [ "$ENGINE" = "podman" ]; then echo "podman compose"
  else die "no compose implementation found (tried docker-compose, docker compose, podman compose)"
  fi
}

compose() {
  local files=(-f "$COMPOSE_INSTALLER")
  local environment=()
  local socket
  engine_is_rootless_podman && files+=(-f "$COMPOSE_MACHINE")
  case "$(runner_mode)" in
    trusted-local) files+=(-f "$COMPOSE_TRUSTED_LOCAL") ;;
    *)             files+=(-f "$COMPOSE_ISOLATED") ;;
  esac
  [ "$(suggestions_state)" = "on" ] && files+=(--profile suggest)
  if [ "$ENGINE" = "podman" ]; then
    socket="$(podman_socket)" || return 1
    environment+=("DOCKER_HOST=unix://$socket")
  fi
  # shellcheck disable=SC2046
  env "${environment[@]}" EZCORP_DATA_ROOT="$DATA_ROOT" EZCORP_SEARXNG_CONFIG="$SEARXNG_CONFIG" \
    $(compose_cmd) "${files[@]}" --project-directory "$CONFIG_DIR" --env-file "$ENV_FILE" "$@"
}

# Always point Compose at the selected engine, including native Linux Podman
# when Docker is installed too. Keep paths as one argument, even with spaces.
podman_socket() {
  local socket
  if podman machine inspect >/dev/null 2>&1; then
    socket="$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true)"
  else
    socket="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null || true)"
  fi
  [ -n "$socket" ] || die "could not find the Podman API socket. Start podman.socket on Linux, or the Podman VM on macOS."
  printf '%s' "$socket"
}

machine_running() {
  [ "$ENGINE" = "podman" ] || return 0
  podman machine inspect >/dev/null 2>&1 || return 0   # native podman, no VM
  [ "$(podman machine inspect --format '{{.State}}' 2>/dev/null)" = "running" ]
}

ensure_machine() {
  [ "$ENGINE" = "podman" ] || return 0
  podman machine inspect >/dev/null 2>&1 || return 0
  machine_running && return 0
  step "Starting the container VM (this takes a moment)..."
  quiet podman machine start || die "could not start the Podman VM. Try: podman machine start"
}

image_present() {
  $ENGINE image exists "$1" 2>/dev/null || $ENGINE image inspect "$1" >/dev/null 2>&1
}

ensure_engine_compatibility() {
  detect_engine
  # Rootful engines do not map an arbitrary login UID to the image's UID.
  # Never fix this by taking ownership of the user's existing data.
  if [ "$(uname -s)" = Linux ] && ! engine_is_rootless_podman && [ "$(id -u)" != 1000 ]; then
    die "the Linux $ENGINE bind mounts require the app's UID 1000. Use rootless Podman with your own account; no data ownership was changed."
  fi
}

ensure_runtime() {
  ensure_engine_compatibility
  ensure_runner_config
  ensure_machine
}

# ── Port selection ─────────────────────────────────────────────────────────
#
# Only the HOST side of the mapping varies. EZCORP_PORT is never set by the
# installer: the image pins it to 3000 and in-container loopback callers
# depend on that. What must track the chosen port is EZCORP_PUBLIC_URL, which
# feeds ORIGIN — left unset, svelte-adapter-bun defaults the scheme to https
# and login breaks over plain HTTP.
# A CONNECT probe is not sufficient here, and the failure it misses is the
# common one. A stopped container leaves podman's port forward (an ssh/gvproxy
# listener) bound to the host port: nothing accepts the connection, so a
# connect probe calls the port free, and compose then fails to bind it —
# observed on this machine with a leftover forward on 4000 after the VM
# restarted. Ask the OS who is LISTENING instead, and keep the connect probe
# only as a last resort on hosts with neither tool.
port_free() {
  local p="$1"
  if command -v lsof >/dev/null 2>&1; then
    ! lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1
  elif command -v ss >/dev/null 2>&1; then
    ! ss -ltnH "sport = :$p" 2>/dev/null | grep -q .
  else
    ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null
  fi
}

pick_port() {
  local p="$PORT_FIRST"
  while [ "$p" -le "$PORT_LAST" ]; do
    if port_free "$p"; then printf '%s' "$p"; return 0; fi
    p=$((p + 1))
  done
  die "ports $PORT_FIRST-$PORT_LAST are all in use. Free one and run 'ezcorp install' again."
}

# ── Config ─────────────────────────────────────────────────────────────────
rand_b64() { openssl rand -base64 "$1" | tr -d '\n'; }

write_env() {
  local port="$1" image="$2"
  umask 077
  cat > "$ENV_FILE" <<ENV
# Written by the EZCorp installer. Safe to read, do not share.
#
# The three secrets below would each auto-generate on first boot
# (src/providers/encryption.ts, src/auth/jwt.ts). They are written explicitly
# anyway so that persistence does not depend on a single mechanism: pinning
# EZCORP_DB_PATH/EZCORP_SECRETS_DIR in the compose file is the other half.
# Losing them means every stored provider key is undecryptable and every
# session is dead.
EZCORP_IMAGE=$image
EZCORP_PORT_HOST=$port
EZCORP_PUBLIC_URL=http://localhost:$port
FORCE_SECURE_COOKIES=false
EZCORP_ENCRYPTION_SECRET=$(rand_b64 32)
EZCORP_ENCRYPTION_SALT=$(rand_b64 16)
EZCORP_JWT_SECRET=$(rand_b64 32)
SEARXNG_SECRET=$(openssl rand -hex 32)
EZCORP_UPDATE_REPO=$UPDATE_REPO
ENV
  append_runner_settings "$(runner_mode)" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

env_get() { [ -f "$ENV_FILE" ] && sed -n "s/^$1=//p" "$ENV_FILE" | head -1; }

edit_env() {
  # Callers must stop on failure; errexit does not cover the left side of &&.
  sed -i.bak "$1" "$ENV_FILE" || return 1
  rm -f "$ENV_FILE.bak"
}

append_runner_settings() {
  local target="$1" output="$2"
  printf 'EZCORP_INSTALL_RUNNER_MODE=%s\n' "$target" >> "$output"
  if [ "$target" = trusted-local ]; then
    # Callers must have completed consent_trusted_local first.
    printf 'EZCORP_EXTENSIONS_UNSANDBOXED_ACK=%s\n' "$UNSANDBOXED_ACK" >> "$output"
  else
    printf 'EZ_RUNNER_SOCKET_DIR=%s\nEZ_RUNNER_TOKEN_FILE=%s\nEZ_RUNNER_GROUP=%s\n' \
      "$EZ_RUNNER_SOCKET_DIR" "$EZ_RUNNER_TOKEN_FILE" "$EZ_RUNNER_GROUP" >> "$output"
  fi
}

# Rewrite only installer-owned runner settings. Keep encryption keys, the
# selected image, port, and all other user data exactly as they were.
write_runner_settings() {
  local target="$1" output="$2"
  sed -e '/^EZCORP_INSTALL_RUNNER_MODE=/d' \
      -e '/^EZCORP_EXTENSIONS_UNSANDBOXED_ACK=/d' \
      -e '/^EZ_RUNNER_SOCKET_DIR=/d' \
      -e '/^EZ_RUNNER_TOKEN_FILE=/d' \
      -e '/^EZ_RUNNER_GROUP=/d' "$ENV_FILE" > "$output" || return 1
  append_runner_settings "$target" "$output"
  chmod 600 "$output"
}

# Which extension runner this install uses. An install from before modes existed
# has no record and is isolated, which is all it could have been.
runner_mode() {
  if [ -n "$RUNNER_MODE" ]; then printf '%s' "$RUNNER_MODE"; return; fi
  local recorded; recorded="$(env_get EZCORP_INSTALL_RUNNER_MODE 2>/dev/null || true)"
  printf '%s' "${recorded:-isolated}"
}

# Decision C (docs/decisions/2026-09-12-extension-runner-install-burden.md),
# offered on first install ONLY when no isolated runner is configured, or by
# the explicit runner-mode command. A terminal prompt adds friction, but a
# program can create a terminal; per-release approval remains the authority.
# Three things it deliberately does not do:
#   - accept a flag or env var in place of the typed answer: the app's
#     acknowledgement is a sentence precisely so it cannot be switched on by
#     copying a line, and an installer flag would be exactly that line;
#   - fall back to it: a partially configured or broken isolated runner stays
#     a hard error (ensure_runner_config), never an invitation to downgrade;
#   - weaken the per-release approval: each extension build and release still
#     needs its own explicit acknowledgement inside the app.
consent_trusted_local() {
  if [ ! -t 0 ]; then
    if [ -f "$ENV_FILE" ]; then
      die "trusted-local mode needs a terminal confirmation. Run 'ezcorp runner-mode trusted-local' at a terminal."
    fi
    die "choosing to run extensions without isolation needs a terminal prompt. Either:
    - provision the isolated runner and set EZ_RUNNER_SOCKET_DIR,
      EZ_RUNNER_TOKEN_FILE and EZ_RUNNER_GROUP (deploy/extension-runner/README.md), or
    - run 'ezcorp install' in a terminal and choose trusted-local mode there."
  fi
  say ""
  say "EZCorp's extensions normally run in an isolated runner: a separate,"
  say "locked-down service that needs administrator setup on a Linux host."
  say "You are choosing whether to run without that service."
  say ""
  say "You can instead run extensions INSIDE EZCorp, without that isolation."
  say "An extension would then have everything EZCorp has: your conversations,"
  say "your saved API keys, every user's data, and your network. It could use"
  say "unlimited CPU, memory and disk. None of the seven sandbox controls apply."
  say ""
  say "EZCorp will still ask you to approve each extension before it builds and"
  say "before it runs, and will show a warning banner while this mode is on."
  say "Choose this only on a computer you alone use, for extensions you trust."
  say ""
  say "Everything else in EZCorp works the same either way."
  say ""
  printf 'Type I understand to continue, or anything else to stop: '
  local answer=""
  read -r answer || true
  [ "$answer" = "I understand" ] || die "not confirmed — no changes were made."
}

# The core connects to a provisioned isolated runner. It cannot provision a
# host service, and it never changes the security mode without an explicit
# command and terminal consent for trusted-local.
ensure_runner_config() {
  if [ "$(runner_mode)" = trusted-local ]; then
    [ "$(env_get EZCORP_EXTENSIONS_UNSANDBOXED_ACK)" = "$UNSANDBOXED_ACK" ] \
      || die "this install records trusted-local mode but not its acknowledgement.
  Run 'ezcorp runner-mode trusted-local' at a terminal to restore it; your data and secrets are kept."
    return 0
  fi
  # Consent is offered only when NOTHING about an isolated runner is set — by
  # env or by a previous install. One or two of the three means someone is
  # configuring isolation and made a mistake, and that stays an error below.
  if [ ! -f "$ENV_FILE" ] && [ -z "${EZ_RUNNER_SOCKET_DIR+x}" ] \
     && [ -z "${EZ_RUNNER_TOKEN_FILE+x}" ] && [ -z "${EZ_RUNNER_GROUP+x}" ]; then
    consent_trusted_local
    RUNNER_MODE=trusted-local
    return 0
  fi
  RUNNER_MODE=isolated
  validate_isolated_runner_config
}

validate_isolated_runner_config() {
  local key value
  for key in EZ_RUNNER_SOCKET_DIR EZ_RUNNER_TOKEN_FILE EZ_RUNNER_GROUP; do
    value="${!key-}"
    if [ -z "${!key+x}" ]; then value="$(env_get "$key" || true)"; fi
    [ -n "$value" ] || die "$key is required. Provision the isolated extension runner first; see deploy/extension-runner/README.md."
    export "$key=$value"
  done
  [[ "$EZ_RUNNER_GROUP" =~ ^[0-9]+$ ]] || die "EZ_RUNNER_GROUP must be a numeric container-visible group. See deploy/extension-runner/README.md."
  [[ "$EZ_RUNNER_SOCKET_DIR" = /* ]] \
    || die "EZ_RUNNER_SOCKET_DIR must be an absolute path to the provisioned socket directory. See deploy/extension-runner/README.md."
  [[ "$EZ_RUNNER_TOKEN_FILE" = /* ]] \
    || die "EZ_RUNNER_TOKEN_FILE must be an absolute path to the runner credential file. See deploy/extension-runner/README.md."
  # The host login may not belong to the app's mapped supplementary group.
  # Compose rejects absent mounts; the app entrypoint checks access, peer UID,
  # credentials and isolation from the actual container. Never read the token.
}

write_state() {
  cat > "$STATE_FILE" <<JSON
{
  "version": "$(env_get EZCORP_IMAGE | sed 's/.*://')",
  "port": $(env_get EZCORP_PORT_HOST),
  "dataRoot": "$DATA_ROOT",
  "suggestions": "$(suggestions_state)",
  "installedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON
}

suggestions_state() {
  [ -f "$CONFIG_DIR/.suggestions-on" ] && { echo on; return; }
  echo off
}

app_url() { printf 'http://localhost:%s' "$(env_get EZCORP_PORT_HOST)"; }

# ── Readiness ──────────────────────────────────────────────────────────────
#
# /api/ready distinguishes "still booting" from "booted but the data dir could
# not be opened" (src/db/connection.ts). The degraded case must NOT open a
# browser: the user would land on a broken app with no idea their data needs
# recovering, and the recovery path involves the backups directory that only
# this script knows the location of.
wait_ready() {
  local url deadline body
  url="$(app_url)/api/ready"
  deadline=$(( $(date +%s) + READY_TIMEOUT_SECONDS ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    body="$(curl -sS --max-time 5 "$url" 2>/dev/null || true)"
    case "$body" in
      *'"state":"ready"'*)    return 0 ;;
      *'data-recovery-needed'*)
        say ""
        say "EZCorp started, but it could not open its database."
        say "Your data has NOT been touched or deleted."
        say "  data:    $DATA_ROOT/data"
        say "  backups: $DATA_ROOT/data/backups"
        say "Restore the most recent backup folder over 'ezcorp', then run 'ezcorp start'."
        return 2
        ;;
    esac
    sleep 2
  done
  return 1
}

require_ready() {
  local result=0
  wait_ready || result=$?
  case "$result" in
    0) return 0 ;;
    2) return 1 ;;
    *) die "EZCorp did not become ready in time. Run 'ezcorp status'." ;;
  esac
}

open_browser() {
  local url; url="$(app_url)"
  case "$(uname -s)" in
    Darwin) open "$url" ;;
    *) command -v xdg-open >/dev/null 2>&1 && xdg-open "$url" >/dev/null 2>&1 || say "Open $url in your browser." ;;
  esac
}

# ── Commands ───────────────────────────────────────────────────────────────
cmd_install() {
  ensure_runtime
  local image port
  image="${EZCORP_IMAGE:-$IMAGE_REPO:${EZCORP_VERSION:-$VERSION_FALLBACK}}"

  mkdir -p "$CONFIG_DIR" "$DATA_ROOT"/{data,extensions,extension-data,projects}

  if [ -f "$ENV_FILE" ]; then
    say "EZCorp is already set up. Starting it instead."
    cmd_start
    return
  fi

  port="$(pick_port)"
  [ "$port" = "$PORT_FIRST" ] || say "Port $PORT_FIRST was busy, using $port."
  write_env "$port" "$image"

  # A pre-seeded image (offline install, an admin who loaded a tarball, or a
  # developer testing a local build) is already correct — pulling would fail
  # on a tag that exists nowhere but this machine.
  if image_present "$image"; then
    step "Using the EZCorp image already on this machine."
  else
    step "Downloading EZCorp (about 1 GB, one time)..."
    quiet compose pull || die "could not download EZCorp.
  Check your internet connection and run 'ezcorp install' again.
  If this persists the image may not be published yet: $image"
  fi

  step "Starting EZCorp..."
  quiet compose up -d || die "EZCorp could not start. Run 'ezcorp status' for details."

  step "Waiting for EZCorp to be ready..."
  require_ready || exit 1

  write_state
  say ""
  say "EZCorp is running at $(app_url)"
  say "Create your account in the browser window that just opened."
  say ""
  say "  ezcorp stop     stop it        ezcorp update   get the latest version"
  say "  ezcorp start    start it       ezcorp status   check on it"
  open_browser
}

cmd_start() {
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet. Run 'ezcorp install'."
  ensure_runtime
  step "Starting EZCorp..."
  quiet compose up -d || die "EZCorp could not start. Run 'ezcorp status' for details."
  require_ready || exit 1
  say "EZCorp is running at $(app_url)"
  open_browser
}

# An explicit mode change also repairs a lost trusted-local acknowledgement.
# The old config is kept until the new stack reaches ready; a failed switch
# restores it without replacing the data or encryption keys.
cmd_runner_mode() {
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet. Run 'ezcorp install'."
  local target="${1:-}" previous candidate backup
  case "$target" in
    isolated|trusted-local) ;;
    *) die "usage: ezcorp runner-mode isolated|trusted-local" ;;
  esac
  ensure_engine_compatibility
  previous="$(runner_mode)"
  if [ "$target" = trusted-local ]; then
    if [ "$previous" = trusted-local ] && [ "$(env_get EZCORP_EXTENSIONS_UNSANDBOXED_ACK)" = "$UNSANDBOXED_ACK" ]; then
      say "Extensions already use trusted-local mode."
      return 0
    fi
    consent_trusted_local
  else
    validate_isolated_runner_config
  fi
  ensure_machine

  candidate="$(mktemp "$CONFIG_DIR/.env.runner-new.XXXXXX")" || die "could not prepare runner settings. No changes were made."
  backup="$(mktemp "$CONFIG_DIR/.env.runner-old.XXXXXX")" \
    || { rm -f "$candidate"; die "could not back up runner settings. No changes were made."; }
  cp -p "$ENV_FILE" "$backup" && write_runner_settings "$target" "$candidate" \
    || { rm -f "$candidate" "$backup"; die "could not prepare runner settings. No changes were made."; }

  step "Changing extension runner mode to $target..."
  quiet compose stop \
    || { rm -f "$candidate" "$backup"; die "could not stop EZCorp. Runner mode was not changed."; }
  mv "$candidate" "$ENV_FILE" \
    || { rm -f "$candidate" "$backup"; die "could not save runner settings. EZCorp remains stopped; run 'ezcorp start'."; }

  if quiet compose up -d && wait_ready; then
    rm -f "$backup"
    say "Extensions now use $target mode. Approve each extension release again before running it."
    return 0
  fi

  say "The new mode did not become ready. Restoring $previous mode..."
  local stopped=0
  quiet compose stop || stopped=1
  mv "$backup" "$ENV_FILE" || die "could not restore the prior runner settings. EZCorp remains stopped; the backup is at $backup."
  [ "$stopped" = 0 ] || die "the prior settings were restored, but the failed container could not be stopped. Stop it before starting EZCorp."
  quiet compose up -d && wait_ready \
    || die "the prior settings were restored, but EZCorp could not restart. Run 'ezcorp status'."
  die "could not change runner mode. $previous mode was restored and EZCorp restarted."
}

# `stop` deliberately leaves the podman machine running: it may be hosting
# other containers, and starting it again is slow. --all is the explicit
# opt-in for shutting the VM down too.
cmd_stop() {
  detect_engine
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet."
  machine_running || { say "EZCorp is not running."; return 0; }
  step "Stopping EZCorp..."
  quiet compose stop || die "could not stop EZCorp. Your data was not removed. Run 'ezcorp status'."
  say "EZCorp stopped. Your data is untouched."
  if [ "${1:-}" = "--all" ] && [ "$ENGINE" = "podman" ] && podman machine inspect >/dev/null 2>&1; then
    step "Stopping the container VM..."
    quiet podman machine stop || true
  fi
}

cmd_status() {
  detect_engine
  say "engine:      $ENGINE ($(compose_cmd))"
  if [ "$ENGINE" = "podman" ] && podman machine inspect >/dev/null 2>&1; then
    say "VM:          $(podman machine inspect --format '{{.State}}' 2>/dev/null || echo unknown)"
    say "subuid room: $(podman machine ssh 'cat /etc/subuid' 2>/dev/null | head -1 || echo 'unknown') (preview uids need 90000-99000)"
  fi
  if [ -f "$ENV_FILE" ]; then
    say "version:     $(env_get EZCORP_IMAGE)"
    say "url:         $(app_url)"
    say "data:        $DATA_ROOT"
    say "suggestions: $(suggestions_state)"
    case "$(runner_mode)" in
      trusted-local) say "extensions:  trusted-local — NOT sandboxed; each release needs your approval" ;;
      *)             say "extensions:  isolated runner" ;;
    esac
  else
    say "not set up   run 'ezcorp install'"
    return 0
  fi
  machine_running || { say "state:       VM stopped"; return 0; }
  local body; body="$(curl -sS --max-time 5 "$(app_url)/api/ready" 2>/dev/null || true)"
  say "ready:       ${body:-not responding}"
  [ "${EZCORP_VERBOSE:-0}" = "1" ] && compose ps || true
}

cmd_open() {
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet. Run 'ezcorp install'."
  require_ready || exit 1
  open_browser
}

# Updates run from the HOST. The app cannot pull and recreate itself without a
# mounted container socket, which compose.prod.yml already records as
# host-root-equivalent and rejected. The rollback leg matters more than the
# upgrade leg: a migration that fails on someone's only copy of their data is
# the worst outcome this installer can produce.
cmd_update() {
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet. Run 'ezcorp install'."
  ensure_runtime

  local current target snapshot
  current="$(env_get EZCORP_IMAGE)"
  if [ -n "${1:-}" ]; then
    target="$IMAGE_REPO:$1"
  else
    step "Checking for a newer version..."
    local tag
    tag="$(curl -fsS --max-time 10 "https://api.github.com/repos/$UPDATE_REPO/releases/latest" 2>/dev/null \
      | sed -n 's/.*"tag_name": *"app-v\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$tag" ] || die "could not reach the update server. Try again later."
    target="$IMAGE_REPO:$tag"
  fi

  [ "$target" = "$current" ] && { say "EZCorp is already up to date ($current)."; return 0; }

  step "Backing up your data..."
  quiet compose stop || die "could not stop EZCorp. Update cancelled before copying or changing data."
  snapshot="$(mktemp -d "$DATA_ROOT/pre-update-XXXXXX")" || die "could not create a backup directory. EZCorp remains stopped."
  cp -a "$DATA_ROOT/data/." "$snapshot/" || die "could not back up your data — update stopped, nothing changed."

  step "Downloading $target..."
  if ! quiet $ENGINE pull "$target"; then
    quiet compose up -d && wait_ready \
      || die "could not download the update, and EZCorp could not restart. The old image and data are unchanged. Run 'ezcorp status'."
    die "could not download the update. EZCorp was restarted unchanged."
  fi

  edit_env "s|^EZCORP_IMAGE=.*|EZCORP_IMAGE=$target|" \
    || die "could not save the update image. EZCorp remains stopped. Your pre-update backup is at $snapshot."
  if quiet compose up -d && wait_ready; then
    write_state
    rm -rf "$snapshot"
    say "Updated to $target."
  else
    say "The update did not come up cleanly. Rolling back to $current..."
    quiet compose stop || die "could not stop the failed update. No data was restored or removed. Your pre-update backup is at $snapshot. Stop the containers before recovery."
    edit_env "s|^EZCORP_IMAGE=.*|EZCORP_IMAGE=$current|" \
      || die "could not save the rollback image. EZCorp remains stopped. Neither data copy was removed; your pre-update backup is at $snapshot."
    rm -rf "$DATA_ROOT/data" && mv "$snapshot" "$DATA_ROOT/data" \
      || die "could not restore the backup at $snapshot. EZCorp remains stopped."
    quiet compose up -d && wait_ready \
      || die "restored the data and image $current, but EZCorp could not restart. Run 'ezcorp status'."
    die "rolled back to $current. Your data was restored from the backup taken before the update."
  fi
}

cmd_suggestions() {
  [ -f "$ENV_FILE" ] || die "EZCorp is not set up yet. Run 'ezcorp install'."
  ensure_runtime
  case "${1:-}" in
    on)
      touch "$CONFIG_DIR/.suggestions-on"
      grep -q '^EZCORP_SUGGEST_OLLAMA_URL=' "$ENV_FILE" 2>/dev/null \
        || echo 'EZCORP_SUGGEST_OLLAMA_URL=http://ollama:11434' >> "$ENV_FILE"
      say "Local suggestions on. Downloading the model (about 1 GB)..."
      quiet compose up -d || die "could not start the suggestion model."
      say "Done."
      ;;
    off)
      # The URL must go too: with the profile off there is no such host, and a
      # set URL means the composer dials a dead address on every keystroke.
      edit_env '/^EZCORP_SUGGEST_OLLAMA_URL=/d' \
        || die "could not save the suggestion setting. No containers were changed."
      rm -f "$CONFIG_DIR/.suggestions-on"
      quiet compose up -d app || die "could not apply the suggestion setting to EZCorp. Run 'ezcorp start'."
      quiet compose --profile suggest stop ollama ollama-init || die "could not stop the suggestion model. Run 'ezcorp status'."
      say "Local suggestions off."
      ;;
    *) die "usage: ezcorp suggestions on|off" ;;
  esac
}

# What is removed without asking is everything this installer created and can
# recreate. What is never removed without an explicit, typed confirmation is
# everything the user made: their conversations, their projects, and the
# secrets those are encrypted with. Podman itself and the VM are never touched
# — they may be serving something else entirely.
cmd_uninstall() {
  detect_engine
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1

  if [ -f "$ENV_FILE" ] && machine_running; then
    step "Stopping EZCorp..."
    quiet compose down || die "could not stop and remove the EZCorp containers. No data was deleted."
  fi

  if [ "$purge" = "1" ]; then
    say ""
    say "This permanently deletes ALL EZCorp data:"
    say "  $DATA_ROOT"
    say "Conversations, projects and encryption keys. This cannot be undone."
    printf 'Type DELETE to confirm: '
    local answer; read -r answer
    [ "$answer" = "DELETE" ] || die "not confirmed — nothing was deleted."
    rm -rf "$DATA_ROOT" "$CONFIG_DIR"
    say "EZCorp and all its data were removed."
  else
    # .env is deliberately KEPT. It holds EZCORP_ENCRYPTION_SECRET, and the
    # data left behind is encrypted with it: deleting the one while keeping
    # the other turns "reinstall to pick up where you left off" into a fresh
    # install with orphaned data — every stored provider key undecryptable,
    # every session dead, and no error message saying so. Only --purge, which
    # removes both, may delete it.
    rm -f "$STATE_FILE"
    say ""
    say "EZCorp was removed. Your data is still here:"
    say "  $DATA_ROOT"
    say "Reinstall to pick up where you left off, or delete that folder yourself."
    say "To remove it now: ezcorp uninstall --purge"
  fi
}

dispatch() {
  case "${1:-}" in
    install)     shift; cmd_install "$@" ;;
    start)       shift; cmd_start "$@" ;;
    stop)        shift; cmd_stop "$@" ;;
    status)      shift; cmd_status "$@" ;;
    open)        shift; cmd_open "$@" ;;
    update)      shift; cmd_update "$@" ;;
    runner-mode) shift; cmd_runner_mode "$@" ;;
    suggestions) shift; cmd_suggestions "$@" ;;
    uninstall)   shift; cmd_uninstall "$@" ;;
    ""|-h|--help|help)
      say "EZCorp — a self-hosted AI platform that runs on your own machine."
      say ""
      say "  ezcorp install              set up and start EZCorp"
      say "  ezcorp start | stop         start or stop it"
      say "  ezcorp open                 open it in your browser"
      say "  ezcorp status               check on it"
      say "  ezcorp update [version]     get the latest version"
      say "  ezcorp runner-mode MODE     change extension runner mode"
      say "  ezcorp suggestions on|off   local suggestion model (~1 GB, 4 GB RAM)"
      say "  ezcorp uninstall [--purge]  remove it (--purge also deletes your data)"
      ;;
    *) die "unknown command: $1 — run 'ezcorp help'" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:-}" in
    install|start|stop|update|runner-mode|suggestions|uninstall) with_lifecycle_lock "$@" ;;
    *) dispatch "$@" ;;
  esac
fi
