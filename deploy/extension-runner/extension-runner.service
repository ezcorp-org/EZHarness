[Unit]
Description=EZHarness isolated extension runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ezharness
EnvironmentFile=%h/.config/ezharness/runner.env
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# User services do not inherit a login shell's PATH (notably on NixOS).
Environment=PATH=/opt/ezharness/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/sh -ec 'for tool in podman python3 flock setpriv; do command -v "$$tool" >/dev/null || { echo "Missing runner tool: $$tool" >&2; exit 1; }; done'
ExecStart=/opt/ezharness/bin/bun packages/@ezcorp/extension-runner/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
Delegate=yes
UMask=0027
LimitNOFILE=8192
TasksMax=1024
MemoryMax=8G

[Install]
WantedBy=default.target
