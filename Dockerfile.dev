# Development image — installs all dependencies (including devDependencies)
# but skips the SvelteKit production build. Source code is bind-mounted at runtime.
#
# Pinned to match `.bun-version` (the repo's single pin source — see the note
# in ci.yml). The floating `oven/bun:1` this used to carry meant any upstream
# 1.x push invalidated every layer below, including both installs.
FROM oven/bun:1.3.14
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
WORKDIR /app

# System packages. `git` is required at runtime by `installFromGit` — the
# extension installer shells out to `git clone` / `git ls-remote` for the
# source:"git" install path, and the web-server process is the one that
# spawns those commands, so the binary has to be on $PATH in this image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

# The dev stack runs as root for its trusted-local runner socket, but all
# image-backed app files must belong to UID:GID 1000. Set ownership while each
# small tree is created; a recursive chown after dependency installs copies
# every lower-layer inode up through overlayfs.
RUN mkdir -p /app/state /app/cache /app/web/.ezcorp /app/.ezcorp/extension-releases \
 && chown 1000:1000 /app /app/state /app/cache /app/web /app/web/.ezcorp /app/.ezcorp /app/.ezcorp/extension-releases
USER 1000:1000

# Install root dependencies (all, including dev)
COPY --chown=1000:1000 package.json bun.lock ./
# Workspace package.json files must be present before `bun install` can resolve
# `workspace:*` specifiers. Only the manifests are needed here — the source
# gets bind-mounted/COPY'd later.
COPY --chown=1000:1000 packages/@ezcorp/sdk/package.json packages/@ezcorp/sdk/
COPY --chown=1000:1000 packages/@ezcorp/ai-kit/package.json packages/@ezcorp/ai-kit/
COPY --chown=1000:1000 packages/@ezcorp/harness-client/package.json packages/@ezcorp/harness-client/
COPY --chown=1000:1000 packages/@ezcorp/extension-contract/package.json packages/@ezcorp/extension-contract/
COPY --chown=1000:1000 packages/@ezcorp/extension-runner/package.json packages/@ezcorp/extension-runner/
# `--ignore-scripts`: the @ezcorp/sdk package's `prepare` script (and the
# root `postinstall`) compile the SDK to dist/ via tsc, but only the
# package.json files have been COPY'd at this stage (the SDK source +
# tsconfig.build.json land later via `COPY . .`). Skipping lifecycle
# scripts lets the cache-friendly install layer succeed; the dev image
# builds the trusted workspace packages after their sources are copied below.
# Vite resolves their standard import exports, which require dist/ even when
# its dev server runs under Bun. Same install ordering for the web package.
#
# The cache mount keeps Bun's global package cache across builds, so an
# invalidated install layer re-links from disk instead of re-downloading the
# whole dependency set from npm. `sharing=locked` because two concurrent
# builds (dev + test) would otherwise race on the same cache dir. Matches the
# prod `Dockerfile`, which has had this since it was written.
RUN --mount=type=cache,target=/home/bun/.bun/install/cache,uid=1000,gid=1000,sharing=locked BUN_INSTALL_CACHE_DIR=/home/bun/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

# Install web dependencies (all, including dev)
COPY --chown=1000:1000 web/package.json web/bun.lock web/
RUN --mount=type=cache,target=/home/bun/.bun/install/cache,uid=1000,gid=1000,sharing=locked BUN_INSTALL_CACHE_DIR=/home/bun/.bun/install/cache sh -c 'cd web && bun install --frozen-lockfile --ignore-scripts'

# Copy everything for initial setup (source is bind-mounted over this at runtime)
COPY --chown=1000:1000 . .

# The SDK build also builds its extension-contract project reference. Keep
# standard import exports available to Vite on the first clean app start.
RUN bun run --cwd packages/@ezcorp/sdk build --force \
 && bun run --cwd packages/@ezcorp/harness-client build --force

# The root runtime identity is intentional: it reads the trusted-local runner
# socket while rootless Podman maps that identity to the invoking host user.
USER root

EXPOSE 3000

ENV EZCORP_PORT=3000
