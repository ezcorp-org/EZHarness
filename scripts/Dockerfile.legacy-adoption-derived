# Test-only repair for the retained main image. The base remains the immutable
# 537f074e image; this adds only the PGlite pgvector bundle its generated
# server chunk resolves at boot.
#
# That release's web package did not list pgvector, so its server chunk lacks
# `vector.tar.gz`. Its ROOT install does ship `@electric-sql/pglite-pgvector`
# 0.0.8, peer-pinned to the PGlite 0.5.7 it runs, so the asset comes from the
# legacy image itself: the bytes its own release locked. It used to be copied
# from the candidate, which broke when pgvector 0.0.11 was rebuilt for PGlite
# 0.5.10 (its `vector.so` needs symbols only PGlite 0.5.9 and later export).
#
# The pinned version and sha256 live in ONE place,
# scripts/legacy-adoption-vector-asset.pin. scripts/verify-legacy-adoption.sh
# passes them in as VECTOR_VERSION and VECTOR_SHA256; neither has a default,
# and scripts/lib/legacy-vector-asset.sh fails the build on any other bytes.
ARG LEGACY_BASE=localhost/ezcorp-extension-v4:legacy-main-537f074e
FROM ${LEGACY_BASE}
ARG LEGACY_BASE_ID
ARG VECTOR_SHA256
ARG VECTOR_VERSION
USER root
COPY scripts/lib/legacy-vector-asset.sh /tmp/legacy-vector-asset.sh
RUN sh /tmp/legacy-vector-asset.sh /app/node_modules/@electric-sql/pglite-pgvector \
      /app/web/build/server/chunks/vector.tar.gz "${VECTOR_SHA256}" "${VECTOR_VERSION}" \
  && chown bun:bun /app/web/build/server/chunks/vector.tar.gz \
  && rm /tmp/legacy-vector-asset.sh
LABEL org.opencontainers.image.revision="537f074e7303ecdf3cbef1a7af4fd60a3244b0a3" \
      org.ezcorp.legacy-adoption.base-image="${LEGACY_BASE_ID}" \
      org.ezcorp.legacy-adoption.vector-sha256="${VECTOR_SHA256}" \
      org.ezcorp.legacy-adoption.delta="pglite-pgvector-${VECTOR_VERSION} vector.tar.gz from the legacy image's own root install (PGlite 0.5.7)"
USER bun
