# Test-only repair for the retained main image. The base remains the immutable
# 537f074e image; this adds only the PGlite pgvector bundle its generated
# server chunk resolves at boot.
#
# The base runs PGlite 0.5.7, so the asset crosses PGlite versions here. Which
# asset, and why it may cross, is recorded in ONE place:
# scripts/legacy-adoption-vector-asset.pin. scripts/verify-legacy-adoption.sh
# reads that pin, checks the candidate's asset against it, and passes the
# measured checksum and the pinned version in as VECTOR_SHA256 and
# VECTOR_VERSION. Neither has a default here, so a build that skips the
# verifier fails instead of using a stale copy.
ARG LEGACY_BASE=localhost/ezcorp-extension-v4:legacy-main-537f074e
ARG ASSET_SOURCE=localhost/ezcorp-extension-v4:terra-final-26541024
FROM ${ASSET_SOURCE} AS asset_source
FROM ${LEGACY_BASE}
ARG LEGACY_BASE_ID
ARG VECTOR_SHA256
ARG VECTOR_VERSION
USER root
COPY --from=asset_source /app/web/node_modules/@electric-sql/pglite-pgvector/dist/vector.tar.gz /app/web/build/server/chunks/vector.tar.gz
RUN test -n "${VECTOR_SHA256}" && test -n "${VECTOR_VERSION}" \
  && echo "${VECTOR_SHA256}  /app/web/build/server/chunks/vector.tar.gz" | sha256sum -c - \
  && chown bun:bun /app/web/build/server/chunks/vector.tar.gz
LABEL org.opencontainers.image.revision="537f074e7303ecdf3cbef1a7af4fd60a3244b0a3" \
      org.ezcorp.legacy-adoption.base-image="${LEGACY_BASE_ID}" \
      org.ezcorp.legacy-adoption.vector-sha256="${VECTOR_SHA256}" \
      org.ezcorp.legacy-adoption.delta="pglite-pgvector-${VECTOR_VERSION} vector.tar.gz from candidate with PGlite 0.5.7"
USER bun
