# Test-only repair for the retained main image. The base remains the immutable
# 537f074e image; this adds only the PGlite pgvector bundle its generated
# server chunk resolves at boot.
#
# The base runs PGlite 0.5.7 and the candidate now runs 0.5.8, so the asset
# crosses a PGlite version here. That is safe because it is not a new build:
# `pglite-pgvector` 0.0.9's tarball extracts to the same bytes as 0.0.8's — the
# same `vector.so`, headers, and `vector--*.sql` — and only the tar mtimes
# moved. Both PGlite versions also bundle the same PostgreSQL 18.3, so the
# extension ABI on each side is the one this `vector.so` was built for. The
# checksum comment in scripts/verify-legacy-adoption.sh carries the recipe that
# proved it; re-run it before the asset crosses a wider gap than this one.
ARG LEGACY_BASE=localhost/ezcorp-extension-v4:legacy-main-537f074e
ARG ASSET_SOURCE=localhost/ezcorp-extension-v4:terra-final-26541024
FROM ${ASSET_SOURCE} AS asset_source
FROM ${LEGACY_BASE}
ARG LEGACY_BASE_ID
# Kept in step with `asset_sha256` in scripts/verify-legacy-adoption.sh, which
# overrides it with the value it measured on the candidate. Read the comment
# there before moving either: the asset is repacked on every pgvector release,
# so the pin moves without the extension changing.
ARG VECTOR_SHA256=881caf1c550dc4ecde6bfae95018d90684c6a61189273f13e0071595819513a2
USER root
COPY --from=asset_source /app/web/node_modules/@electric-sql/pglite-pgvector/dist/vector.tar.gz /app/web/build/server/chunks/vector.tar.gz
RUN echo "${VECTOR_SHA256}  /app/web/build/server/chunks/vector.tar.gz" | sha256sum -c - \
  && chown bun:bun /app/web/build/server/chunks/vector.tar.gz
LABEL org.opencontainers.image.revision="537f074e7303ecdf3cbef1a7af4fd60a3244b0a3" \
      org.ezcorp.legacy-adoption.base-image="${LEGACY_BASE_ID}" \
      org.ezcorp.legacy-adoption.delta="pglite-pgvector-0.0.9 vector.tar.gz from candidate with PGlite 0.5.7"
USER bun
