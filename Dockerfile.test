# Pinned to match `.bun-version` (the repo's single pin source — see the note
# in ci.yml). The floating `oven/bun:1` this used to carry meant any upstream
# 1.x push invalidated every layer below — including the Playwright
# `--with-deps` install, which is the most expensive step in this file.
FROM oven/bun:1.3.14
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
WORKDIR /app

# Install git (for extension installer tests) and Node.js (for Playwright)
RUN apt-get update && \
    apt-get install -y git curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install root dependencies
COPY package.json bun.lock ./
# Workspace package.json required to resolve `workspace:*` specifiers.
COPY packages/@ezcorp/sdk/package.json packages/@ezcorp/sdk/
COPY packages/@ezcorp/ai-kit/package.json packages/@ezcorp/ai-kit/
COPY packages/@ezcorp/harness-client/package.json packages/@ezcorp/harness-client/
COPY packages/@ezcorp/extension-contract/package.json packages/@ezcorp/extension-contract/
COPY packages/@ezcorp/extension-runner/package.json packages/@ezcorp/extension-runner/
# `--ignore-scripts`: SDK source + tsconfig haven't been COPY'd yet (only
# the package.json), so the `prepare` script's tsc build can't succeed.
# Skip lifecycle here; the SDK is rebuilt as needed once `COPY . .` lands.
# Bun's "bun" exports condition resolves the SDK's raw .ts at runtime.
#
# Cache mount keeps Bun's global package cache across builds so an invalidated
# install layer re-links from disk instead of re-downloading from npm.
# `sharing=locked` because a concurrent dev build uses the same cache dir.
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked bun install --frozen-lockfile --ignore-scripts

# Install web dependencies
COPY web/package.json web/bun.lock web/
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked cd web && bun install --frozen-lockfile --ignore-scripts

# Install Playwright chromium + system deps
RUN cd web && bunx playwright install --with-deps chromium

# Copy all source including tests
COPY . .

# ── Did the tests actually land? ───────────────────────────────────────────
#
# `Dockerfile.test.dockerignore` is a BUILDKIT convention: BuildKit looks for
# `<dockerfile>.dockerignore` and prefers it over the root `.dockerignore`.
# Podman/Buildah do NOT implement that lookup — they apply the root
# `.dockerignore` unless told otherwise with `--ignorefile`. The root file
# excludes `**/*.test.ts`, `**/*.spec.ts` and `**/__tests__`, because the PROD
# image must not ship tests.
#
# So under Podman this image builds "successfully" with every test stripped
# out of it, and the failure surfaces much later as
# `error: preload not found "./src/__tests__/preload.ts"` — once per test file,
# naming neither the ignorefile nor the engine. Measured: 298 files, 0 passes.
#
# Fail here instead, where the fix is one flag:
#   podman build --ignorefile Dockerfile.test.dockerignore -f Dockerfile.test .
RUN if [ ! -f src/__tests__/preload.ts ] || [ ! -d web/e2e ]; then \
      echo "" >&2; \
      echo "error: the test sources are missing from this image's build context." >&2; \
      echo "  Dockerfile.test.dockerignore is a BuildKit-only convention; Podman and" >&2; \
      echo "  Buildah fall back to the root .dockerignore, which strips all tests." >&2; \
      echo "  fix:  <engine> build --ignorefile Dockerfile.test.dockerignore -f Dockerfile.test ." >&2; \
      echo "" >&2; \
      exit 1; \
    fi

# Generate SvelteKit types ($lib alias resolution for web tests)
RUN cd web && bunx svelte-kit sync

# Pre-build SvelteKit for e2e tests
RUN cd web && PI_SKIP_INIT=1 bun run build

ENV EZCORP_DB_PATH=:memory:
ENV CI=1
ENV PI_SKIP_INIT=1

CMD ["bash", "scripts/docker-test-all.sh"]
