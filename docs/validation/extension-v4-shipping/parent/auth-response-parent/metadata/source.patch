+/** Converts a deliberate auth denial into a route response without hiding bugs. */
+function returnThrownResponse<T>(read: () => T): T | Response {
+  try {
+    return read();
+  } catch (error) {
+    if (error instanceof Response) return error;
+    throw error;
+  }
+}
+
+/**
+ * Non-throwing sibling of {@link requireAuth} for `+server.ts` handlers.
+ *
+ * A route that only needs an authenticated principal must use this helper,
+ * rather than letting {@link requireAuth} throw its 401 Response through
+ * SvelteKit as a 500. It preserves the same user and 401 response shapes.
+ */
+export function checkAuth(locals: AuthLocals): AuthUser | Response {
+  return returnThrownResponse(() => requireAuth(locals));
+}
