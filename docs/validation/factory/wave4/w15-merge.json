   ],
   "ruling": "coordinator, approved"
  },
  {
   "what": "bun install --frozen-lockfile in staging for the new dependency @aws-sdk/client-kms 3.1131.0 (typecheck TS2307 before)",
   "ruling": "coordinator, approved"
  },
  {
   "what": "W09b's real-server harness declares the recovery sections exactly as W15's harness does (temporalHttp endpoint on the Temporal dev server's HTTP port; W15's harness has no builder, so the three startup-document hunks are applied byte for byte): w00/harness-w09b, patch w15-merge-w09b-harness-recovery-declaration.patch. The integrator's real-server-pass script now copies this one harness source per run.",
   "reason": "an installation without recovery declarations never reports ready after W15, by design (held checkpoint-barrier -> /api/ready 503 degraded factory-checkpoint-barrier-held)",
   "disclosedTo": "W09b",
   "ruling": "coordinator ruling (a)"
