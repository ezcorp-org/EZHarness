{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezcorp-github-app-directory",
  "main": "../../src/integrations/github-app-directory/worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "logpush": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  },
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "github-auth.ezcorp.org", "custom_domain": true }],
      "vars": {
        "APP_ID": "5049328",
        "APP_CLIENT_ID": "Iv23linp84AzzvCGxstF",
        "APP_SLUG": "ezcorp-github-auth"
      }
    }
  }
}
