{
  "name": "ezcorp-ai-rocks",
  "version": "1.3.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["packages/@ezcorp/*"],
  "scripts": {
    "postinstall": "bun run --cwd packages/@ezcorp/sdk build && bash scripts/setup-git-hooks.sh",
    "start": "bun run index.ts",
    "dev": "cd web && bun run dev",
    "dev:stack": "DATABASE_URL=${DATABASE_URL:-postgres://ezcorp:ezcorp@127.0.0.1:5432/ezcorp} bun run dev",
    "build": "cd web && bun run build",
    "serve": "bun run index.ts serve",
    "preview": "cd web && bun run preview",
    "podman": "bash scripts/podman-compose.sh",
    "test": "bash scripts/test.sh",
    "test:file": "bun test",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:sdk": "bun test --cwd packages/@ezcorp/sdk",
    "test:coverage": "bash scripts/test-coverage.sh",
    "branches:unlanded": "bun run scripts/unlanded-branches.ts",
    "backfill:embeddings": "bun run scripts/backfill-embeddings.ts",
    "verify:backup": "bun run scripts/verify-backup-rollback.ts",
    "verify:edges": "bun run scripts/verify-circuit-breaker-edges.ts",
    "verify:docker": "bash scripts/verify-docker-image.sh",
    "verify:docker-rollback": "bash scripts/verify-docker-rollback.sh",
    "verify:docker-upgrade": "bash scripts/verify-docker-upgrade.sh",
    "verify:all": "bun run verify:backup && bun run verify:edges && bun run verify:docker && bun run verify:docker-rollback && bun run verify:docker-upgrade",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "biome check --no-errors-on-unmatched src web packages scripts extensions worker docs tests index.ts drizzle.config.ts .*.json *.json",
    "lint:fix": "bun run lint --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.9"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.3",
    "@electric-sql/pglite": "0.5.7",
    "@electric-sql/pglite-pgvector": "0.0.8",
    "@ezcorp/ai-kit": "workspace:*",
    "@ezcorp/harness-client": "workspace:*",
    "@ezcorp/sdk": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@zxing/library": "^0.23.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-png": "^8.0.0",
    "file-type": "^22.0.2",
    "jpeg-js": "^0.4.4",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.8.2"
  }
}
