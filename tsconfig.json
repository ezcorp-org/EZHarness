{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "@ezcorp/sdk": ["./packages/@ezcorp/sdk/src/index.ts"],
      "@ezcorp/sdk/*": ["./packages/@ezcorp/sdk/src/*"]
    }
  },
  // `tasks/` is gitignored per-developer scratch (plans, demos, notes). CI
  // never sees it, but including it here means any local scratch file breaks
  // `bun run typecheck` for that developer — so the local gate stops matching CI.
  "exclude": ["web", "tasks", "**/node_modules/**", "**/.svelte-kit/**"]
}
