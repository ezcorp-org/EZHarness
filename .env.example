# ┌─────────────────────────────────────────────────────────────────────┐
# │ EZCorp environment template                                         │
# │                                                                     │
# │ Copy to `.env` and fill in the variables for your deployment mode.  │
# │   cp .env.example .env                                              │
# │                                                                     │
# │ Full reference: docs/production-guide.md                            │
# └─────────────────────────────────────────────────────────────────────┘

# ─── Self-hosted production (compose.prod.yml) ──────────────────────────
#
# Generate both with:
#   openssl rand -base64 32
#
# Stored credentials are encrypted with these values. Treat them as
# durable secrets: changing them on a live instance renders every stored
# credential unreadable. Store in a secret manager for real deployments.

EZCORP_ENCRYPTION_SECRET=
EZCORP_ENCRYPTION_SALT=

# Public-facing URL (used for OAuth callbacks and clickable deep-links).
# Leave empty for localhost; set to your reverse-proxy host otherwise.
# EZCORP_PUBLIC_URL=https://ezcorp.example.com

# JWT signing secret for sessions. If unset, auto-generated and persisted
# (encrypted) in the DB on first boot. Set explicitly to rotate via env
# or manage in a secret manager. Changing it invalidates all live sessions.
# EZCORP_JWT_SECRET=

# Update-check behaviour (in-app banner + /api/version).
# EZCORP_CHECK_UPDATES=true
# EZCORP_UPDATE_REPO=ezcorp-org/EZcorp

# ─── Feature flags ──────────────────────────────────────────────────────
#
# Autonomous `/goal` autopilot: the AI loops on its own until a goal
# condition is met (a cheap-model evaluator judges completion each turn).
# Shipped ON for every install. Set to 0/false/off/no to disable it — when
# off, `/goal` is hidden from the slash-command menu and the interceptor
# returns a "disabled" card.
EZCORP_GOAL_ENABLED=1

# ─── Secure preview port-watcher (Phase 2) ──────────────────────────────
#
# Auto-detection daemon for dev servers that start listening inside a
# conversation's sandbox. Detection only goes live once netns enumeration
# is wired (Phase 3); on the default fail-closed posture it is a no-op.
#
# Kill switch — set to 1 to never start the watcher daemon.
# EZCORP_DISABLE_PREVIEW_WATCHER=1
#
# Poll cadence in ms (default 2000, floored at 250). Lower = more
# responsive detection at the cost of more frequent /proc scans.
# EZCORP_PREVIEW_WATCHER_POLL_MS=2000

# ─── MCP servers on localhost / the LAN ─────────────────────────────────
#
# When you add an `http` or `sse` MCP server, EZCorp dials the URL you
# give it. That is an SSRF surface, so loopback, RFC-1918, link-local
# (169.254.x — cloud metadata), CGNAT and the IPv6 equivalents are
# DENIED by default. (`stdio` servers spawn a process, not a connection,
# and are unaffected.)
#
# Self-hosting on your own box is a normal case, so name the targets you
# trust — comma-, semicolon- or whitespace-separated hosts and/or CIDRs:
# EZCORP_MCP_TARGET_ALLOW=127.0.0.1,::1,192.168.1.50,10.0.0.0/8,mcp.lan
#
# LIST BOTH 127.0.0.1 AND ::1 if your URL says `localhost`. Every address
# the name resolves to must be allowed, and `localhost` is dual-stack —
# allowing only 127.0.0.1 still denies http://localhost:3000/mcp, with
# the same opaque 502. (Or just write 127.0.0.1 in the URL.)
#
# An IP/CIDR entry is checked against every resolved address (safe). A
# HOSTNAME entry vouches for the name and skips that check, so whoever
# controls its DNS controls the target — prefer IP/CIDR.
#
# Entries that are NOT understood are dropped, and the API cannot tell
# you: `192.168.1.50:8080` (drop the port), `http://192.168.1.50` (host
# or CIDR, not a URL) and `10.0.0.0 / 8` (no spaces around /) are all
# rejected. The mcp-target-guard log names them; check there if a target
# you allowlisted is still refused.
#
# Editing this file needs a restart — Bun loads .env at process start.
#
# A refused target returns the same generic 502 as an unreachable one,
# on purpose (a distinguishable answer would map your internal network).
# The real reason lands in the error log. See docs/deployment.md.
#
# MCP server in another container? The default Docker bridge is inside
# the denied 172.16/12 — see docs/deployment.md for that case.

# ─── Web search (SearXNG sidecar) ───────────────────────────────────────
#
# The bundled web-search extension uses the SearXNG sidecar shipped in
# both compose stacks; keyless DuckDuckGo is the automatic fallback when
# the sidecar is down. Both vars have working defaults — only set them
# to point at a BYO SearXNG instance (its settings.yml must enable
# `formats: [json]`, and a custom hostname needs the extension's network
# grant widened — see docs/deployment.md "Web search sidecar").
# SEARXNG_BASE_URL=http://127.0.0.1:8889
#
# Instance secret for the sidecar (dev default: dev-only-secret; the dev
# port is loopback-only so the default is fine).
# SEARXNG_SECRET=

# External Postgres — only set if you've outgrown embedded PGlite.
# The app auto-detects this and skips PGlite + the local snapshot flow;
# backups become your DB provider's responsibility (pg_dump / WAL archive).
# DATABASE_URL=postgres://ezcorp:password@db.example.com:5432/ezcorp

# ─── Optional: credential seeding ───────────────────────────────────────
#
# Seed LLM provider keys at boot instead of entering them in the UI.
# Removed after first successful bootstrap. Prefer Settings > Provider Keys.
# SEED_ANTHROPIC_API_KEY=
# SEED_OPENAI_API_KEY=
# SEED_GOOGLE_API_KEY=

# ─── Optional: Google OAuth provider ────────────────────────────────────
#
# Create a Web Application OAuth client at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:1456/auth/callback as an authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Dev compose (docker-compose.yml — not for production) ──────────────
#
# Only used by the from-source dev stack, which runs an external pgvector
# container with live source mounts. Ignore these for self-hosted deploys.

POSTGRES_DB=ezcorp
POSTGRES_USER=ezcorp
POSTGRES_PASSWORD=ezcorp
POSTGRES_PORT=5432
EZCORP_PORT=3000

# Git identity used by git commands run inside the dev container against the
# /repo self-modification project (README "Self-modification project").
# Commits are blocked there (.git is mounted read-only), so these only matter
# for tooling that reads the configured identity — or if you loosen the mount.
# EZCORP_GIT_NAME=Your Name
# EZCORP_GIT_EMAIL=you@example.com
